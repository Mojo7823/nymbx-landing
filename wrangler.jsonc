// Cloudflare Workers static assets (the successor to Pages). Every response is a file from dist,
// with headers from public/_headers, except /api/*, which runs worker/index.ts (the PHP2Shell
// checker's scan endpoint). Asset requests never invoke the Worker.
{
  "name": "nymbx",
  "compatibility_date": "2026-10-19",
  // Subrequests for nymbx.dev itself go through the public front door, not straight to an origin.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "main": "./worker/index.ts",
  // nymbx.dev is the public site; www is attached too so it gets a certificate.
  "routes": [
    { "pattern": "nymbx.dev", "custom_domain": true },
    { "pattern": "www.nymbx.dev", "custom_domain": true },
  ],
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    // Serve /index.html as-is (the PWA precaches it) instead of 307-redirecting it to /.
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // Per-client limit on /api/phpscan (worker/rateLimiter.ts): one SQLite-backed Durable Object
  // per client IP. Migration tags are append-only; never edit or remove an applied one.
  "durable_objects": {
    "bindings": [{ "name": "PHPSCAN_RATE_LIMIT", "class_name": "ScanRateLimiter" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ScanRateLimiter"] }],
}
