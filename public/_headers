# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/).
# A path matching several rules gets all their headers; a repeated header name is comma-joined.
# Cloudflare sends Cache-Control: public, max-age=0, must-revalidate by default — the always-revalidate policy that
# index.html, sw.js, the manifest, offline-assets.json and the asset catalogs need — so only
# the immutable exceptions are listed below. No 404.html in dist = Pages' built-in SPA fallback.

# Required for WASM libraries that use SharedArrayBuffer (crossOriginIsolated).
# CSP: all runtime resources are same-origin. The only inline script is the theme bootstrap in
# index.html, pinned by hash. 'unsafe-eval' is required by the ONNX runtime (Background Remover)
# and by ajv (JSON Schema tools). 'blob:' in script-src lets the ONNX worker importScripts its blob.
/*
  X-Content-Type-Options: nosniff
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval' blob: 'sha256-GdroxiQLdbFK+NF5ikTwW6bY3eXy6AC9957BY1Cy8FM='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' blob: data:; worker-src 'self' blob:; media-src 'self' blob: data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# The personal page is reachable only by its direct URL and must stay out of search results.
/itsme
  X-Robots-Tag: noindex, nofollow, noarchive
/itsme/*
  X-Robots-Tag: noindex, nofollow, noarchive

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Background-removal model shards are content-hashed; their two catalogs must revalidate.
# `!` drops the immutable value but also the platform default, so no-cache is set explicitly.
/models/*
  Cache-Control: public, max-age=31536000, immutable
/models/resources.json
  ! Cache-Control
  Cache-Control: no-cache
/models/.version
  ! Cache-Control
  Cache-Control: no-cache

# OCR engine and language packs live under version-stamped directories. The pattern needs a
# version segment, so the catalogs /ocr/engine/manifest.json and /ocr/engine/.version don't match
# (one splat per pattern, hence the :version placeholder).
/ocr/engine/:version/*
  Cache-Control: public, max-age=31536000, immutable
/ocr/lang/*
  Cache-Control: public, max-age=31536000, immutable
