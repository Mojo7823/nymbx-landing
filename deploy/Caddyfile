# NYMBX Toolbox — static SPA served by Caddy.
# PORT is set by Zeabur; defaults to 8080 for local runs (see Dockerfile ENV).

:{$PORT:8080} {
	root * /srv

	# Required for WASM libraries that use SharedArrayBuffer (e.g. multithreaded
	# codecs). Applied to every response.
	header {
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Phase 15 (DOCX ↔ PDF, server-assisted) will proxy conversions to the
	# private Gotenberg service. Keep disabled until that phase ships.
	# reverse_proxy /api/convert/* gotenberg.zeabur.internal:3000

	encode zstd gzip

	# Long-cache hashed build assets; index.html stays revalidated.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# SPA fallback: unknown paths serve the app shell.
	try_files {path} /index.html
	file_server
}
