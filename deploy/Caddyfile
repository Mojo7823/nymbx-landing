# NYMBX Toolbox — static SPA served by Caddy.
# PORT is set by Zeabur; defaults to 8080 for local runs (see Dockerfile ENV).

:{$PORT:8080} {
	# SITE_ROOT override lets the same Caddyfile serve a local `dist` when
	# testing outside the container.
	root * {$SITE_ROOT:/srv}

	# Required for WASM libraries that use SharedArrayBuffer (e.g. multithreaded
	# codecs). Applied to every response.
	header {
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# The personal page is intentionally accessible only by its direct URL and
	# must not be included in search results or followed into other pages.
	@personal path /itsme /itsme/*
	header @personal X-Robots-Tag "noindex, nofollow, noarchive"

	encode zstd gzip

	# Phase 15 (DOCX → PDF, server-assisted): proxy conversions to the private
	# Gotenberg service. handle_path strips the prefix, so the client's
	# POST /api/convert/forms/libreoffice/convert reaches Gotenberg as
	# POST /forms/libreoffice/convert. GOTENBERG_UPSTREAM is overridden to
	# `gotenberg:3000` by deploy/docker-compose.yml for local runs.
	handle_path /api/convert/* {
		request_body {
			max_size 30MB
		}
		reverse_proxy {$GOTENBERG_UPSTREAM:gotenberg.zeabur.internal:3000}
	}

	handle {
		# Long-cache hashed build assets; index.html stays revalidated.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# SPA fallback: unknown paths serve the app shell.
		try_files {path} /index.html
		file_server
	}
}
